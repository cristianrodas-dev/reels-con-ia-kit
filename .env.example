# Copia este archivo como .env y completa tus datos. El .env NUNCA se sube (está en .gitignore).
# Guía paso a paso: docs/instalacion.md

# ── Instagram (API con inicio de sesión de Instagram) ──
IG_USER_ID=tu_id_de_usuario_de_instagram
IG_ACCESS_TOKEN=tu_token_de_larga_duracion
IG_APP_ID=tu_app_id
IG_APP_SECRET=tu_app_secret
IG_API_VERSION=v22.0

# ── Almacenamiento para publicar (Supabase, bucket público de solo lectura) ──
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_BUCKET=reels
SUPABASE_SECRET_KEY=tu_clave_secreta_de_servidor

# ── Voz con IA (opcional: elevenlabs | azure | kokoro | edge) ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
